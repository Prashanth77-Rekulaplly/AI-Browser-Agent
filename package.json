{
  "name": "ai-browser-agent",
  "version": "1.0.0",
  "description": "Production-Ready Browser Control Agent with Gemini AI, Playwright, and React Desktop UI",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node src/server.js",
    "test": "node src/test-suite.js",
    "test:browser": "node src/test-browser.js",
    "test:profile": "node src/test-persistent-profile.js",
    "test:theme": "node src/test-theme-toggle.js",
    "agent:demo": "node src/demo-agent.js",
    "agent:cli": "node src/cli.js",
    "browser:login": "node src/login-helper.js",
    "ui:dev": "cd frontend && npm run dev",
    "ui:build": "cd frontend && npm run build",
    "dev": "node src/server.js"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "electron": "^34.2.0"
  }
}
